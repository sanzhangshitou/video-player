# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts,gradle}]
indent_size = 4

[*.{swift}]
indent_size = 4

[*.{pbxproj,xcscheme,xcworkspacedata}]
indent_style = tab
