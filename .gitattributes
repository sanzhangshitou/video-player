# Auto-detect text files and normalize line endings to LF
*          text=auto eol=lf

# --- Source code ---
*.ts       text eol=lf diff=typescript
*.tsx      text eol=lf diff=typescript
*.js       text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.xml      text eol=lf

# --- Ruby / CocoaPods ---
Gemfile      text eol=lf
Gemfile.lock text eol=lf
Podfile      text eol=lf
Podfile.lock text eol=lf
*.podspec    text eol=lf
*.rb         text eol=lf

# --- Native Android ---
*.java      text eol=lf diff=java
*.kt        text eol=lf diff=kotlin
*.kts       text eol=lf diff=kotlin
*.gradle    text eol=lf
*.pro       text eol=lf
*.keystore  binary -text
*.apk       binary -text
*.aab       binary -text

# --- Native iOS ---
*.h         text eol=lf
*.m         text eol=lf
*.mm        text eol=lf
*.swift     text eol=lf diff=swift
*.plist     text eol=lf
*.xcconfig  text eol=lf
*.pbxproj   text eol=lf
*.xcworkspacedata text eol=lf
*.entitlements text eol=lf
*.storyboard binary
*.xib       binary
*.png       binary -text
*.jpg       binary -text
*.jpeg      binary -text
*.gif       binary -text
*.ico       binary -text
*.pdf       binary -text
*.ttf       binary -text
*.otf       binary -text
*.a         binary -text
*.dylib     binary -text
*.framework binary -text
*.xcassets  binary -text
*.xcarchive binary -text

# --- Bundle / Metro ---
*.jsbundle  binary -text

# --- Shell scripts ---
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# --- Git files ---
.gitattributes text eol=lf
.gitignore      text eol=lf
.gitmodules     text eol=lf
.editorconfig   text eol=lf

# --- Lock files ---
yarn.lock   text eol=lf
package-lock.json text eol=lf

# --- Config files ---
.eslintrc*  text eol=lf
.prettierrc* text eol=lf
.browserslistrc text eol=lf
.jestrc*    text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf
metro.config.js text eol=lf
babel.config.js text eol=lf

# --- Generated assets (Android) ---
android/app/src/main/assets/index.android.bundle binary -text

# --- Generators ---
Dockerfile   text eol=lf
.dockerignore text eol=lf
Makefile     text eol=lf

# --- Graph / lock files ---
*.lock  binary -text linguist-generated=true
